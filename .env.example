# Copy to .env.local for local development. NEVER commit real values.
# All variables below are SERVER-ONLY unless prefixed NEXT_PUBLIC_.

# --- Production backend (Supabase PostgreSQL) -------------------------------
# Supabase dashboard → Project Settings → Database → Connection string.
# For Vercel/serverless use the *Transaction pooler* string (port 6543).
# Without DATABASE_URL the app runs in LOCAL DEMO MODE (in-memory, one process).
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# TLS to Supabase. Pick ONE:
#  a) Full verification (recommended): paste Supabase's CA certificate
#     (Dashboard → Database → SSL Configuration → Download certificate).
#     Newlines may be written as \n.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#  b) Encrypted but unverified (trade-off; use only if (a) is impractical):
# DATABASE_SSL_NO_VERIFY=true
#  c) Local Postgres without TLS:
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=5

# --- Access control ----------------------------------------------------------
# If set, creating a game requires this code (strongly recommended when public).
HOST_ACCESS_CODE=change-me

# Extra blocked nickname terms, comma-separated (added to the built-in list).
NICKNAME_BLOCKLIST=

# --- Public URL --------------------------------------------------------------
# Base URL encoded in the QR code. Defaults to the host browser's address, so set
# this when the host opens the app via localhost but phones must use another address.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Local demo only ---------------------------------------------------------
# Allows the in-memory store in a production build (e.g. `next start` on a laptop).
# Never set this on Vercel: instances do not share memory.
# ALLOW_MEMORY_STORE=true

# --- Tests only --------------------------------------------------------------
# Admin connection used by `npm run test:db` to create throwaway databases.
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
